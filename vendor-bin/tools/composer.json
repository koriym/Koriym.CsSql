{
    "name": "koriym/cs-sql-tools",
    "description": "Development tools for koriym/cs-sql.",
    "license": "MIT",
    "require-dev": {
        "doctrine/coding-standard": "^12.0",
        "phpmd/phpmd": "^2.15",
        "phpmetrics/phpmetrics": "^2.8",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "vimeo/psalm": "^6.0"
    },
    "config": {
        "platform": {
            "php": "8.1.31"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
